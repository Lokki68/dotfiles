# ─────────────────────────────────────────
# Aliases
# ─────────────────────────────────────────

# -- Navigation
abbr --add .. 'cd ..'

abbr --add ls 'eza --icons=always'
abbr --add lsa 'eza --icons=always -a'
abbr --add cat bat
abbr --add ex exit
abbr --add c clear
abbr --add n nvim
abbr --add lg lazygit
abbr --add nvc 'cd $HOME/.config/nvim && nvim .'
abbr --add g git

# -- Rails
abbr --add bd bin/dev
abbr --add rs 'rails s'
abbr --add rc 'rails c'
